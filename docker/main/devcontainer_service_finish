#!/command/with-contenv bash
# shellcheck shell=bash
# Devcontainer: log service exit without taking down the supervision tree

set -o errexit -o nounset -o pipefail

readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"
readonly service_name="$(basename "$(dirname "$(realpath "$0")")")"

echo "[INFO] Service ${service_name} exited with code ${exit_code_service} (by signal ${exit_code_signal})"
