+
+
+PoseDetectorTypeEnum = StrEnum("PoseDetectorTypeEnum", {k: k for k in pose_api_types})
+
+PoseDetectorConfig = Annotated[
+    Union[tuple(BasePoseDetectorConfig.__subclasses__())],
+    Field(discriminator="type"),
+]
